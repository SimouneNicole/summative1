#--------------------------------------------------------------------
# Environment Configuration for InfinityFree
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# --------------------------------------------------------------------
# APP
# --------------------------------------------------------------------
# Replace with your actual InfinityFree domain (must end with '/')
app.baseURL = 'http://YOUR_INFINITYFREE_DOMAIN/public/'

# --------------------------------------------------------------------
# DATABASE (InfinityFree)
# --------------------------------------------------------------------

database.default.hostname = YOUR_MYSQL_HOSTNAME
database.default.database = YOUR_DATABASE_NAME
database.default.username = YOUR_MYSQL_USERNAME
database.default.password = YOUR_VPANEL_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
